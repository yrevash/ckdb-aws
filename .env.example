# Local CockroachDB development connection. Never use the insecure local URL in AWS.
DATABASE_URL=postgresql://root@localhost:26257/postmortem?sslmode=disable

# The responder reads through CockroachDB Cloud Managed MCP in deployed environments.
COCKROACH_MCP_URL=https://cockroachlabs.cloud/mcp
COCKROACH_MCP_READER_TOKEN=

# The direct SQL writer is separately scoped and stored in Secrets Manager when deployed.
COCKROACH_WRITER_DATABASE_URL=

AWS_REGION=us-east-1
BEDROCK_REASONING_MODEL=us.anthropic.claude-sonnet-4-6
BEDROCK_CLASSIFIER_MODEL=us.anthropic.claude-3-5-haiku-20241022-v1:0
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0

POSTMORTEM_ORG_ID=00000000-0000-0000-0000-000000000001
POSTMORTEM_AGENT_ID=00000000-0000-0000-0000-000000000002

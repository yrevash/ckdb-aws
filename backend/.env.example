# Local mode requires no AWS or CockroachDB credentials.
POSTMORTEM_RUNTIME_MODE=fake
POSTMORTEM_HOST=0.0.0.0
POSTMORTEM_PORT=8080
POSTMORTEM_LOG_LEVEL=INFO
POSTMORTEM_CORS_ORIGINS=http://localhost:3000

# Stable identities used to scope every recall and write.
POSTMORTEM_ORG_ID=00000000-0000-0000-0000-000000000001
POSTMORTEM_AGENT_ID=00000000-0000-0000-0000-000000000002

# AWS mode.
POSTMORTEM_AWS_REGION=us-east-1
POSTMORTEM_REASONING_MODEL_ID=us.anthropic.claude-sonnet-4-6
POSTMORTEM_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
POSTMORTEM_REASONER=bedrock
# `mcp` preserves the managed read/audit surface; `sql` proves the same recall
# directly against CockroachDB for local evaluation.
POSTMORTEM_RECALL_BACKEND=mcp
# A/B control: bypass all memory reads and force cold reasoning.
POSTMORTEM_COLD_START=false

# Keep credentials in Secrets Manager in deployed environments. This value is
# intentionally a direct DSN only for local development and CI.
POSTMORTEM_DATABASE_URL=

# CockroachDB Managed MCP Streamable HTTP endpoint and read-scoped token.
POSTMORTEM_MCP_URL=
POSTMORTEM_MCP_TOKEN=
